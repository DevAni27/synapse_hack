# Base URL of Aniket's FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  = use built-in placeholder responses (no backend needed)
# false = call the real backend at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_MOCK_MODE=true

# How the backend's mask PNGs mark an artery. Confirm with Aniket.
#   alpha     = transparent everywhere except the artery (recommended)
#   luminance = black/white image, white = artery
NEXT_PUBLIC_MASK_FORMAT=alpha

# Optional: path (under public/) to a real heart model. Leave empty to use the procedural heart.
# NEXT_PUBLIC_HEART_MODEL=/models/heart.glb
