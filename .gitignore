# =========================
# Arbor - root .gitignore
# =========================

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Model checkpoints
*.pt
*.pth
*.ckpt
*.onnx

# Generated model outputs
backend/results/*
!backend/results/.gitkeep

# Model weights
backend/model_weights/*
!backend/model_weights/.gitkeep

# Test / temporary medical images
backend/test_images/

# Next.js / Node
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo