APP_NAME=Arbor Backend
APP_ENV=development

MOCK_MODE=true
DEVICE=auto

MODEL_DIR=model_weights
RESULTS_DIR=results

CLASSIFIER_NAME=convnext_tiny
SEGMENTER_NAME=nnunetv2_2d
MODEL_VERSION=core-v1

MAX_UPLOAD_MB=20
MAX_VIDEO_MB=200
MAX_SAMPLED_VIDEO_FRAMES=24

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CLASSIFIER_CHECKPOINT=model_weights/classifier/lca_rca_resnet18.pt


USE_REAL_CLASSIFIER=true
USE_REAL_SEGMENTER=true